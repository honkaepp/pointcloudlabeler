# --- Repository --------------------------------------------------------
repository-code: "https://github.com/honkaepp/pointcloudlabeler"
url: "https://github.com/honkaepp/pointcloudlabeler"
# The persistent archive: Zenodo, fed from GitHub releases. `doi` is the
# concept DOI, which resolves to the latest version; Zenodo mints each
# version's own DOI when its GitHub release is made, and it is listed
# below once known.
doi: 10.5281/zenodo.22824704
identifiers:
  - type: doi
    value: 10.5281/zenodo.22824704
    description: "Concept DOI — all versions, resolves to the latest"
  - type: doi
    value: 10.5281/zenodo.22824705
    description: "Version 0.1.0"

