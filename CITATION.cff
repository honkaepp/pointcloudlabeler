  - "lidar"
  - "close-range sensing"
  - "terrestrial laser scanning"
  - "mobile laser scanning"
  - "forest monitoring plots"
  - "individual tree segmentation"
  - "multi-temporal point clouds"
  - "tree skeleton transfer"
  - "segmentation editing"
  - "quality control"
  - "forest inventory"
  - "quantitative structure model"
  - "TreeQSM"
  - "biomass"

version: "0.1.1"
date-released: "2026-09-18"   # the day v0.1.1 was tagged
type: software

